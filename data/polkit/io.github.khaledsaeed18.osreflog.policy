<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>osreflog</vendor>
  <vendor_url>https://github.com/KhaledSaeed18/osreflog</vendor_url>

  <action id="io.github.khaledsaeed18.osreflog.read">
    <description>Read the system change history</description>
    <message>Authentication is required to read the system change history</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.khaledsaeed18.osreflog.checkpoint">
    <description>Take a system checkpoint</description>
    <message>Authentication is required to take a system checkpoint</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="io.github.khaledsaeed18.osreflog.undo">
    <description>Undo a system change</description>
    <message>Authentication is required to undo a system change</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
