[Unit]
Description=osreflog: system change history
Documentation=https://github.com/KhaledSaeed18/osreflog
After=local-fs.target dbus.service
Requires=dbus.service
# Offline updates (GNOME Software) boot system-update.target, which doesn't pull in
# multi-user.target: without this the dnf hook finds no daemon and the update gets no
# checkpoints (Q4, 2026-10-16). Up before the offline transaction starts, so its hook does.
Before=dnf5-offline-transaction.service packagekit-offline-update.service
# Never inside a metal bisect probe: it would record into the real history (P7).
ConditionKernelCommandLine=!osreflog.probe
# …and in a booted container probe, which shares the host's kernel command line.
ConditionPathExists=!/var/lib/osreflog-probe/manual

[Service]
Type=dbus
BusName=io.github.khaledsaeed18.osreflog1
ExecStart=/usr/libexec/osreflog/osreflogd
# The btrfs top level is mounted at /run/osreflog/top in this namespace only; osreflogd
# refuses to run in PID 1's mount namespace.
PrivateMounts=yes
RuntimeDirectory=osreflog
RuntimeDirectoryMode=0700
Nice=5

# Hardening that P2 is known to work with, tightened in P8f.
# CAP_SYS_ADMIN: mounts, btrfs ioctls, fanotify filesystem marks; CAP_DAC_READ_SEARCH:
# open_by_handle_at; CAP_BPF + CAP_PERFMON: the lineage eBPF program; CAP_CHOWN, CAP_FOWNER,
# CAP_DAC_OVERRIDE: the undo worker (owners, modes and labels of restored files).
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN CAP_BPF CAP_PERFMON
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
# No RestrictSUIDSGID=: systemd implements it with a seccomp filter that makes openat2(2)
# fail with ENOSYS (it can't inspect the mode inside struct open_how), and undo resolves
# every path with openat2. Undo refuses to restore set-user-ID/set-group-ID bits itself.
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# System call groups osreflogd never uses, refused with EPERM (P8f). An allow-list
# (@system-service) is too narrow for it: it mounts (@mount), sets owners and capabilities
# (@privileged) and the workers' rlimits (@resources). @debug is ptrace and perf_event_open:
# the lineage program attaches through bpf() links, not perf events. The undo and summary
# workers add their own allow-list filter on top of this one.
SystemCallFilter=~@clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
MemoryMax=768M
# glibc keeps one malloc arena per thread and rarely gives freed memory back: after a few
# large diffs on the blocking pool the daemon held 108 MB (P8, 2026-10-17). Two arenas bound it.
Environment=MALLOC_ARENA_MAX=2

[Install]
WantedBy=multi-user.target system-update.target
