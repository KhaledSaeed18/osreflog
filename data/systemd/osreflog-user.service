[Unit]
Description=osreflog: record your settings changes (dconf) and the app that made each
Documentation=https://github.com/KhaledSaeed18/osreflog
After=dbus.socket
Requires=dbus.socket
# Never inside a metal bisect probe: it would record into the real history (P7).
ConditionKernelCommandLine=!osreflog.probe
# …and in a booted container probe, which shares the host's kernel command line.
ConditionPathExists=!/var/lib/osreflog-probe/manual

[Service]
ExecStart=/usr/libexec/osreflog/osreflog-user
Restart=on-failure
RestartSec=5
Nice=5
# The agent reads /proc of your own processes, talks on the session bus, runs `dconf` and
# writes its ledger in ~/.local/state/osreflog; it needs nothing else. In a user unit the
# mount options below imply PrivateUsers=yes (a user namespace with only your uid), which
# still lets it read your own processes. P8f: 8/8 on scripts/p4/user-workload.sh with all of
# this, exposure 8.0 → 0.8.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/osreflog
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
UMask=0077

[Install]
WantedBy=default.target
