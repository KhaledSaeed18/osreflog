# osreflog: a checkpoint before and after every package transaction on this host.
# Read by libdnf5-plugin-actions (dnf, PackageKit). The hook never fails a transaction and
# prints only log.<LEVEL>= lines, as the plugin's plain mode requires.
# callback:package_filter:direction:options:command
pre_transaction:::enabled=host-only:/usr/bin/osreflog hook pre ${pid}
post_transaction:::enabled=host-only:/usr/bin/osreflog hook post ${pid}
